{
  "rewrites": [
    {
      "source": "/ingest/static/:path(.*)",
      "destination": "https://us-assets.i.posthog.com/static/:path"
    },
    {
      "source": "/ingest/array/:path(.*)",
      "destination": "https://us-assets.i.posthog.com/array/:path"
    },
    {
      "source": "/ingest/:path(.*)",
      "destination": "https://us.i.posthog.com/:path"
    },
    { "source": "/coming-soon", "destination": "/index.html" },
    { "source": "/coming-soon/", "destination": "/index.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/terms/", "destination": "/terms.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/privacy/", "destination": "/privacy.html" }
  ],
  "redirects": [
    { "source": "/home.html", "destination": "/home", "permanent": false },
    { "source": "/design-system.html", "destination": "/design-system", "permanent": false },
    { "source": "/playground.html", "destination": "/playground", "permanent": false },
    { "source": "/contact.html", "destination": "/contact", "permanent": false },
    { "source": "/manifesto.html", "destination": "/manifesto", "permanent": false }
  ]
}
